// Copy to Config/Secrets.xcconfig and fill in. That file is git-ignored.
DEVELOPMENT_TEAM = ABCDE12345
// Google Cloud Console > APIs & Services > Credentials > OAuth client ID (iOS), bundle id fi.tasan.app
GOOGLE_CLIENT_ID = 1234567890-abcdefg.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abcdefg
// Optional: point the app at another deployment of Worker/ (e.g. wrangler dev through a tunnel)
// TASAN_AI_HOST = tasan-ai.example.workers.dev
// TASAN_AI_KEY = same value as the worker's APP_KEY
