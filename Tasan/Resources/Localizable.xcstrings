          }
        }
      }
    },
    "Vastuu palaa automaattisesti valittuna päivänä, esimerkiksi loman tai työmatkan jälkeen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The responsibility comes back automatically on the chosen day, for example after a holiday or a work trip."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ansvaret återgår automatiskt den valda dagen, till exempel efter en semester eller tjänsteresa."
          }
        }
      }
    },
    "Vastuu pysyy ennallaan ja %@ saa tiedon." : {
