    "%@ pysyy sinun vastuullasi. Auttaja saa osatehtävän omaan listaansa ja kalenteriinsa, kun hyväksyy." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stays your responsibility. The helper gets the sub-task on their own list and calendar once they accept."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ förblir ditt ansvar. Hjälparen får deluppgiften på sin egen lista och i sin kalender när hen godkänner."
          }
        }
      }
    },
