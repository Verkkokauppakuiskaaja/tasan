    "Valmistelu näkyy kalenterissa omana merkintänään. Ilman omaa aikaa muistutus tulee valmistelupäivänä klo 9." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The preparation shows as its own entry in the calendar. Without a custom time, the reminder comes at 9:00 on the preparation day."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förberedelsen visas som en egen post i kalendern. Utan egen tid kommer påminnelsen kl. 9 på förberedelsedagen."
          }
        }
