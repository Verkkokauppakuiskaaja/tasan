    "Perhe tallentui tähän puhelimeen, mutta iCloud-yhteys ei onnistunut: %@. Kirjaudu iCloudiin, niin voit kutsua toisen aikuisen." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The family was saved on this phone, but iCloud could not be reached: %@. Sign in to iCloud to invite the other adult."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Familjen sparades på den här telefonen, men iCloud gick inte att nå: %@. Logga in på iCloud för att bjuda in den andra vuxna."
          }
        }
      }
    },
