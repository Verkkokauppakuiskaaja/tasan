    "Vuosikello lisää tehtävät ajoissa. Voit myös lisätä tehtävän itse tai kuvasta." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The year clock adds tasks in good time. You can also add a task yourself or from a photo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Årsklockan lägger till uppgifter i god tid. Du kan också lägga till en uppgift själv eller från en bild."
          }
