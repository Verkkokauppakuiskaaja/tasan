    },
    "Avoimet vastuut nyt. Tasataan yhdessä, ei lasketa pisteitä." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open responsibilities right now. Even it out together, no keeping score."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna ansvar just nu. Jämna ut tillsammans, utan att räkna poäng."
          }
        }
      }
    },
